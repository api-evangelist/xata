        },
        {
          "info": {
            "name": "Request organization deletion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.xata.tech/organizations/:organizationID/deletion-request",
            "params": [
              {
                "name": "organizationID",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a specific organization"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://auth.xata.io/realms/xata/protocol/openid-connect/auth",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Flags the organization for deletion. The request is rejected if the organization still has active projects.\nThe subscription is cancelled immediately and any outstanding invoices are collected automatically after a grace period that prevents missing delayed usage reports.\nDeletion completes asynchronously once all invoices are issued and settled.\n"
        },
        {
