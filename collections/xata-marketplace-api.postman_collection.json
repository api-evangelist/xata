      "item": [
        {
          "id": "81f36df0-88c9-4588-a4a3-7bc30694a4a5",
          "name": "Register with a cloud marketplace",
          "request": {
            "name": "Register with a cloud marketplace",
            "description": {
              "content": "Links the authenticated user to a cloud marketplace subscription. Only one marketplace registration is allowed per user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "marketplace",
                "register"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "org:read org:write keys:read keys:write project:read project:write branch:read branch:write metrics:read logs:read credentials:read credentials:write marketplace:write"
                },
                {
                  "key": "authUrl",
                  "value": "https://auth.xata.io/realms/xata/protocol/openid-connect/auth"
                },
                {
                  "key": "grant_type",
                  "value": "implicit"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marketplace\": \"<string>\",\n  \"company_name\": \"<string>\",\n  \"aws\": {\n    \"customer_id\": \"<string>\",\n    \"product_id\": \"<string>\",\n    \"account_id\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
