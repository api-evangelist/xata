              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "oauth2",
                  "oauth2": [
                    {
                      "key": "scope",
                      "value": "org:read org:write keys:read keys:write project:read project:write branch:read branch:write metrics:read logs:read credentials:read credentials:write marketplace:write",
                      "type": "string"
                    },
                    {
                      "key": "authUrl",
                      "value": "https://auth.xata.io/realms/xata/protocol/openid-connect/auth",
                      "type": "string"
                    },
                    {
                      "key": "grant_type",
                      "value": "implicit",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"marketplace\": \"aws\",\n  \"company_name\": \"<string>\",\n  \"aws\": {\n    \"customer_id\": \"<string>\",\n    \"product_id\": \"<string>\",\n    \"account_id\": \"<string>\"\n  }\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/marketplace/register",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "marketplace",
                    "register"
                  ]
                },
                "description": "Links the authenticated user to a cloud marketplace subscription. Only one marketplace registration is allowed per user."
