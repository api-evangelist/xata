          "info": {
            "name": "List API Keys for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.xata.tech/organizations/:organizationID/api-keys",
            "params": [
              {
                "name": "organizationID",
                "value": "",
                "type": "path",
                "description": "Unique identifier for a specific organization"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://auth.xata.io/realms/xata/protocol/openid-connect/auth",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Retrieve a list of API keys for a specific organization."
        },
