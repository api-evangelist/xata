{
  "item": [
    {
      "id": "1f02e171-494e-40e6-b3aa-0c77017ac523",
      "name": "Gateway",
      "description": {
        "content": "PostgreSQL connectivity via HTTP SQL, WebSocket wire protocol proxy, and native wire protocol.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "38106d9f-ed6b-4935-b656-ce3b1300bcdf",
          "name": "Execute SQL query",
          "request": {
            "name": "Execute SQL query",
            "description": {
              "content": "Execute a single SQL query or a batch of queries against a PostgreSQL branch.\n\n**Authentication:** send the branch's PostgreSQL connection string in the\n`Connection-String` header. The control-plane API key (Bearer token) is\n**not** accepted on the gateway host.\n\n**Routing:** the target branch, region, and endpoint type are taken from the\nhostname embedded in the connection string, which must match the request host.\nSee the `Connection-String` security scheme for the host format.\n\n**Single query:** provide `query` (and optional `params`) at the top level.\n\n**Batch:** provide `queries` as an array of query objects, or send the request body\nas a JSON array. Batch queries execute within a single transaction.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sql"
              ],
              "host": [
                "{{sql-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "When `true`, return rows as arrays instead of objects.",
                "key": "Array-Mode",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "When `true`, return all values as strings without type conversion.",
                "key": "Raw-Text-Output",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "Transaction isolation level for batch queries.",
                "key": "Batch-Isolation-Level",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "When `true`, execute the batch transaction in read-only mode.",
                "key": "Batch-Read-Only",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "When `true`, execute the batch transaction in deferrable mode.",
                "key": "Batch-Deferrable",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Connection-String"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"<string>\",\n  \"queries\": [\n    {\n      \"query\": \"<string>\",\n      \"arrayMode\": \"<boolean>\"\n    },\n    {\n      \"query\": \"<string>\",\n      \"arrayMode\": \"<boolean>\"\n    }\n  ],\n  \"arrayMode\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "722538f9-5707-4624-a2b4-3fac3d06d66a",
              "name": "Query executed successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "sql"
                  ],
                  "host": [
                    "{{sql-Url}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "Connection-String",
                    "value": "<API Key>"
                  },
                  {
                    "disabled": false,
                    "description": "When `true`, return rows as arrays instead of objects.",
                    "key": "Array-Mode",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "When `true`, return all values as strings without type conversion.",
                    "key": "Raw-Text-Output",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "Transaction isolation level for batch queries.",
                    "key": "Batch-Isolation-Level",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "When `true`, execute the batch transaction in read-only mode.",
                    "key": "Batch-Read-Only",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "When `true`, execute the batch transaction in deferrable mode.",
                    "key": "Batch-Deferrable",
                    "value": "<string>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"query\": \"SELECT id, name FROM users WHERE id = $1\",\n  \"params\": [\n    42\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"fields\": [\n    {\n      \"name\": \"id\",\n      \"tableID\": 0,\n      \"columnID\": 0,\n      \"dataTypeID\": 23,\n      \"dataTypeSize\": 4,\n      \"dataTypeModifier\": -1,\n      \"format\": \"text\"\n    },\n    {\n      \"name\": \"name\",\n      \"tableID\": 0,\n      \"columnID\": 0,\n      \"dataTypeID\": 25,\n      \"dataTypeSize\": -1,\n      \"dataTypeModifier\": -1,\n      \"format\": \"text\"\n    }\n  ],\n  \"command\": \"SELECT\",\n  \"rowCount\": 1,\n  \"rows\": [\n    {\n      \"id\": 42,\n      \"name\": \"Ada\"\n    }\n  ],\n  \"rowAsArray\": false\n}",
              "cookie": [],
